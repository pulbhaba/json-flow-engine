{
  "schemaVersion": 1,
  "provider": "hubspot",
  "name": "HubSpot",
  "description": "HubSpot CRM v3 contacts. Authenticate with a private-app access token (bearer).",
  "baseUrl": "https://api.hubapi.com",
  "allowedHosts": ["api.hubapi.com"],
  "auth": { "type": "bearer" },
  "actions": {
    "create-contact": {
      "description": "Create a contact (POST /crm/v3/objects/contacts).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "properties": {
            "type": "object",
            "description": "HubSpot contact properties, e.g. email, firstname, lastname.",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        },
        "required": ["properties"],
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/crm/v3/objects/contacts",
        "body": { "properties": "{{input.properties}}" }
      },
      "response": {
        "successStatus": [201],
        "output": {
          "id": "{{input.body.id}}",
          "properties": "{{input.body.properties}}",
          "createdAt": "{{input.body.createdAt}}",
          "updatedAt": "{{input.body.updatedAt}}"
        }
      }
    },
    "update-contact": {
      "description": "Update a contact by id (PATCH /crm/v3/objects/contacts/{contactId}).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contactId": { "type": "string", "minLength": 1 },
          "properties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        },
        "required": ["contactId", "properties"],
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/crm/v3/objects/contacts/{{input.contactId}}",
        "body": { "properties": "{{input.properties}}" }
      },
      "response": {
        "successStatus": [200],
        "output": {
          "id": "{{input.body.id}}",
          "properties": "{{input.body.properties}}",
          "updatedAt": "{{input.body.updatedAt}}"
        }
      }
    },
    "search-contacts": {
      "description": "Full-text search over contacts (POST /crm/v3/objects/contacts/search).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/crm/v3/objects/contacts/search",
        "body": { "query": "{{input.query}}", "limit": "{{input.limit ?? 10}}" }
      },
      "response": {
        "successStatus": [200],
        "output": {
          "total": "{{input.body.total}}",
          "results": "{{input.body.results}}"
        }
      }
    }
  }
}
